{
  "name": "AulaViva",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": { 
    "cpus": 4, 
    "memory": "16gb" 
  },
  "forwardPorts": [8080],
  "portsAttributes": { 
    "8080": { 
      "label": "AulaViva", 
      "onAutoForward": "notify" 
    } 
  },
  "postCreateCommand": "cd backend && mvn -q -B -DskipTests package"
}
